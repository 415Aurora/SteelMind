FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libreoffice-writer fonts-noto-cjk libgomp1 libgfortran5 libgl1 libglu1-mesa && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt /app/backend/requirements.txt
RUN python -m pip install --no-cache-dir -r backend/requirements.txt
COPY backend /app/backend
COPY examples /app/examples
COPY Knowledge /app/Knowledge
ENV STEEL_ARTIFACT_DIR=/data/files STEELMIND_OUTPUT_ROOT=/data/exports STEEL_TOOL_PUBLIC_URL=http://127.0.0.1:8000
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000"]
