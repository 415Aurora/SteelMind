    "inputs": {
      "query": "string",
      "top_k": "integer, default 5",
      "standard_id": "optional string"
    }
  },
  "get_clause": {
    "description": "按标准号和条款号读取条款",
    "inputs": {
      "standard_id": "string",
      "clause_no": "string"
    }
  },
  "lookup_material": {
    "description": "按钢材牌号和厚度查询设计强度",
